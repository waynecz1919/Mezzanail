# Existing public website routes do not require environment variables.
# The following values are server-only and used by Mezzanail Redeem Center.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDEEM_SESSION_SECRET=replace-with-at-least-32-random-characters
REDEEM_STAFF_USERS=[{"id":"staff-id","role":"staff","salt":"base64url-salt","hash":"base64url-scrypt-hash"}]
JACKPOT_STAFF_USERS=[{"id":"owner-id","role":"owner","salt":"base64url-salt","hash":"base64url-scrypt-hash"}]

# Server-only job application delivery. Never prefix these with NEXT_PUBLIC_.
# EMAIL_FROM_ADDRESS must use a sender verified by the email provider.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_replace_with_resend_sending_key
EMAIL_FROM_ADDRESS=Mezzanail Careers <jobs@mezzanail.com>
JOB_APPLICATION_RECIPIENT=mezzanailstudio@gmail.com
JOB_APPLICATION_HASH_SECRET=replace-with-at-least-32-random-characters
