# Existing public website routes do not require environment variables.
# The following values are server-only and used by Mezzanail Redeem Center.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDEEM_SESSION_SECRET=replace-with-at-least-32-random-characters
REDEEM_STAFF_USERS=[{"id":"staff-id","salt":"base64url-salt","hash":"base64url-scrypt-hash"}]
